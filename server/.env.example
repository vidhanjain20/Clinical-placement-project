# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit real secrets. This file (.env.example) has no real values
# in it and IS safe to commit, as a template for what's needed.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://dashboard.clerk.com -> your app -> API Keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# https://sentry.io -> your project -> Settings -> Client Keys (DSN)
SENTRY_DSN=

PORT=4000
