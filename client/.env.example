# Copy to .env and fill in. Vite only exposes vars prefixed VITE_ to the
# browser bundle — never put a secret key here, only the publishable one.

# Same Clerk app as server/.env, but the PUBLISHABLE key (safe for the
# browser) — https://dashboard.clerk.com -> your app -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=

# Where the Phase 1 backend is running
VITE_API_URL=http://localhost:4000
